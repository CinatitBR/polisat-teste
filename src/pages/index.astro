---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import earth from '../assets/earth.png'
import cubesat from '../assets/cubesat.png'
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<h1>POLISAT</h1>


			<div class="timer">
				<header>
					<div class="timer-title">LASC</div>
					
					<div class="timer-display">
						<span id="timer-days"></span> dias <span id="timer-hours"></span>h <span id="timer-minutes"></span>m <span id="timer-seconds"></span>s
					</div>
				</header>

				<div class="circle-countdown">
					<svg viewBox="0 0 300 300" class="timer-circle">
						<defs>
							<!-- Define the gradient here -->
							<linearGradient id="progress-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
								<stop offset="0%" stop-color="white" />   <!-- Start color (Cyan) -->
								<stop offset="100%" stop-color="white" /> <!-- End color (Blue) -->
							</linearGradient>
						</defs>
		
						<!-- Background Track -->
						<circle cx="150" cy="150" r="142.5" stroke-width="15" fill="none" />
						
						<!-- Animated Fill pointing to the gradient ID -->
						<circle class="progress-ring" cx="150" cy="150" r="142.5" stroke="url(#progress-gradient)" stroke-width="15" fill="none" />
	
						<image id="progress-icon" href={cubesat.src} width="100" />
					</svg>
	
					<Image class="earth" src={earth} alt="Planet earth" />
				</div>
			</div>


			<h3>Conheça nossos subsistemas</h3>

			<section class="conteudo">
				<div>
					<h4> > Carga Útil</h4>
					<p>A carga útil é o instrumento ou experimento específico que o satélite carrega — pode ser uma câmera de alta resolução, um sensor meteorológico ou um novo componente tecnológico que estamos testando em ambiente de microgravidade.</p>
				</div>

				<div>
					<h4> > Controle Térmico (TCS)</h4>
					<p>O espaço pode ser extremamente quente ou congelante. O TCS utiliza isolantes e radiadores para manter todos os componentes eletrônicos dentro de uma faixa de temperatura segura, evitando que o satélite "derreta" sob o sol ou pare de funcionar no frio do vácuo.</p>
				</div>

				<div>
					<h4> > Determinação e Controle de Atitude (ADCS)</h4>
					<p>É o subsistema que dá orientação ao satélite. Utilizando sensores e atuadores (como magnetômetros e rodas de reação), o ADCS garante que o CubeSat esteja sempre apontado para o lado certo — seja para alinhar as antenas com a Terra ou os painéis com o Sol.</p>
				</div>
				
				<div>
					<h4> > Suprimento de Energia (EPS)</h4>
					<p>O coração elétrico do satélite. O EPS gerencia a geração de energia através de painéis solares, o armazenamento em baterias e a distribuição precisa de voltagem para que nenhum componente fique sem "combustível" durante o eclipse na órbita terrestre.</p>
				</div>
			</section>

			<canvas width="600" height="300">Animação satélite</canvas>
		</main>
	</body>
</html>

<script>
	// @ts-nocheck

	const svg = document.querySelector(".circle-countdown svg")
	const icon = document.querySelector("#progress-icon")
	const circles = document.querySelectorAll(".circle-countdown svg circle")
	const ring = circles[1]

	const maxWidth = 400
	const strokeWidth = 7

	let center, circumference, radius = 0

	// maxWidth, strokeWidth: properties of the timer in pixels
	function setTimer() {
		center = maxWidth / 2
		radius = center - (strokeWidth / 2)
		circumference = 2 * Math.PI * radius

		// Set up the initial circle state
		svg?.setAttribute('viewBox', `0 0 ${maxWidth} ${maxWidth}`)

		// Set up the initial circle state
		circles.forEach((circle) => {
			circle.setAttribute('cx', center)
			circle.setAttribute('cy', center)
			circle.setAttribute('stroke-width', strokeWidth)
			circle.setAttribute('r', radius)

		})

		ring.style.strokeDasharray = `${circumference}`;
		ring.style.strokeDashoffset = `${circumference}`;
		ring.style.transformOrigin = `${center}px ${center}px`
	}

	// Percent should be a value between 0 and 1
	function setProgress(percent) {
		const offset = circumference - percent * circumference;
		ring.style.strokeDashoffset = offset;

		// Convert offset to radians
		let angle = (percent * 2 * Math.PI) - (Math.PI / 2)
		
		const iconX = center + radius * Math.cos(angle)
		const iconY = center + radius * Math.sin(angle)

		icon?.setAttribute('x', iconX - 50)
		icon?.setAttribute('y', iconY - 35)
	}

	function updateTimer() {
		const start = (new Date(2025, 10, 5, 0)).valueOf();
		const final = (new Date(2026, 8, 2, 0)).valueOf();
		const now = (new Date()).valueOf()

		const timeDiff = final - now

		let days = timeDiff / (24 * 60 * 60 * 1000)
		let hours = (days - Math.trunc(days)) * (24)
		let minutes = (hours - Math.trunc(hours)) * 60
		let seconds = (minutes - Math.trunc(minutes)) * 60
		
		// Format the numbers to be two digit integers
		let fDays = Math.trunc(days).toString().padStart(2, '0')
		let fHours = Math.trunc(hours).toString().padStart(2, '0')
		let fMinutes = Math.trunc(minutes).toString().padStart(2, '0')
		let fSeconds = Math.trunc(seconds).toString().padStart(2, '0')

		document.querySelector("#timer-days").textContent = fDays;
		document.querySelector("#timer-hours").textContent = fHours;
		document.querySelector("#timer-minutes").textContent = fMinutes;
		document.querySelector("#timer-seconds").textContent = fSeconds;

		const totalDuration = final - start
		const progressRation = 1 - (timeDiff / totalDuration)
		setProgress(progressRation)
	}

	setTimer()
	updateTimer()
	setInterval(updateTimer, 1000)
</script>

<style>
	h1 {
		/* POLISAT */
		font-family: 'Monoton';
		font-style: normal;
		font-weight: 400;
		font-size: 78px;
		letter-spacing: 0.15em;
		text-align: center;
		margin-bottom: 3rem;

		background: linear-gradient(92.78deg,#FAFF76 15%,#FF6A00 29%,#935EFF 58%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		text-fill-color: transparent;
	}
	h4 {
		font-size: 1.35rem;
		margin: 0;
	}
	p {
		font-size: 1rem;
		margin: 0 0 0 0;
	}

	.conteudo {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1rem;
	}

	/* Timer */
	.timer header {
		width: fit-content;
		margin: 0 auto;
		margin-bottom: 1rem;
	}

	.timer .timer-title {
		font-size: 1.5rem;
		width: fit-content;
		margin: 0 auto;
	}

	.timer .timer-display {
		font-size: 1.4rem;
	}

	.circle-countdown {
		display: grid;
		place-items: center;
		position: relative;
		max-width: 400px;
		height: 400px;
		margin: 0 auto;
	}

	.earth {
		position: absolute;
		z-index: -1;
		max-width: 87%;
	}

	.timer-display {
		font-weight: bold;
		font-size: 1.75rem;
		background-color: #19181b;
	}

	.timer-circle {
		width: 100%;             /* Fills the width of whatever container it sits in */
		height: auto;            /* Maintains the perfect 1:1 aspect ratio automatically */
		display: block;
		margin: 0 auto;          /* Centers the container horizontally */
		position: absolute;
	}

	.progress-ring {
		transform: rotate(-90deg);
		
		stroke-linecap: round; /* Seamless rounded caps */
	}

	#progress-icon {
		animation: floating 1.2s alternate infinite ease-in-out;
	}

	@keyframes floating {
		0% {
			transform: rotate(-2deg) translateY(4px);
		}
		100% {
			transform: translateY(-4px);
		}
	}
</style>
